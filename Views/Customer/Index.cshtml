
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StyleStore - Clothing Store</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            font-family: Arial, sans-serif;
        }

        .brand {
            font-size: 28px;
            font-weight: bold;
        }

        .hero {
            background-color: #f5eee6;
        }

        .hero-img {
            width: 100%;
            height: 450px;
            object-fit: cover;
        }

        .category-img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .shop-btn {
            background-color: #252525;
            color: white;
        }

        .shop-btn:hover {
            background-color: #d98957;
            color: white;
        }

        .footer {
            background-color: #f5eee6;
        }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg bg-white shadow-sm">
        <div class="container">

            <a class="navbar-brand brand" href="/Customer/Index">
                StyleStore<span class="text-warning">.</span>
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarItems">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarItems">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Customer/Index">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Home/About">About</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Product/Index">Shop</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Home/Contact">Contact</a>
                    </li>

                </ul>

                <div class="d-flex gap-4 justify-content-center">

                    <a href="/Home/Search" class="text-dark">
                        <i class="bi bi-search fs-5"></i>
                    </a>

                    <a href="/Home/Profile" class="text-dark">
                        <i class="bi bi-person fs-5"></i>
                    </a>

                    <a href="/Home/Wishlist" class="text-dark">
                        <i class="bi bi-heart fs-5"></i>
                    </a>

                    <a href="/Cart/Index" class="text-dark">
                        <i class="bi bi-bag fs-5"></i>
                    </a>

                </div>

            </div>
        </div>
    </nav>


    <!-- HERO SECTION -->
    <div class="container my-4">

        <div class="row align-items-center hero">

            <div class="col-md-6 p-5">

                <p class="text-warning fw-bold">
                    NEW CLOTHING COLLECTION
                </p>

                <h1 class="display-4 fw-bold">
                    Dress Better.<br>
                    Feel Better.
                </h1>

                <p class="text-secondary mt-3">
                    Discover stylish clothing for every day.
                    Find your own style with StyleStore.
                </p>

                <a href="/Product/Index" class="btn shop-btn mt-3 p-3">
                    SHOP NOW <i class="bi bi-arrow-right"></i>
                </a>

            </div>

            <div class="col-md-6 p-0">

                <img src="https://images.unsplash.com/photo-1539109136881-3be0616acf4b?w=900"
                     class="hero-img"
                     alt="Fashion Collection">

            </div>

        </div>
    </div>


    <!-- SHOP BY CATEGORY -->
    <div class="container my-5">

        <div class="text-center mb-4">

            <h2 class="fw-bold">Shop by Category</h2>

            <p class="text-secondary">
                Find clothing that matches your style.
            </p>

        </div>

        <div class="row g-4">

            <!-- MEN -->
            <div class="col-12 col-md-4">

                <a href="/Product/Index?category=men">
                    <img src="https://images.unsplash.com/photo-1617137968427-85924c800a22?w=600"
                         class="category-img rounded"
                         alt="Men Clothing">
                </a>

                <h5 class="text-center mt-3 fw-bold">
                    Men's Clothing
                </h5>

            </div>

            <!-- WOMEN -->
            <div class="col-12 col-md-4">

                <a href="/Product/Index?category=women">
                    <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?w=600"
                         class="category-img rounded"
                         alt="Women Clothing">
                </a>

                <h5 class="text-center mt-3 fw-bold">
                    Women's Clothing
                </h5>

            </div>

            <!-- KIDS -->
            <div class="col-12 col-md-4">

                <a href="/Product/Index?category=kids">
                    <img src="https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=600"
                         class="category-img rounded"
                         alt="Kids Clothing">
                </a>

                <h5 class="text-center mt-3 fw-bold">
                    Kids' Clothing
                </h5>

            </div>

        </div>
    </div>


    <!-- PROMOTIONAL SECTION -->
    <div class="container my-5">

        <div class="row align-items-center bg-light">

            <div class="col-md-6 p-5">

                <p class="text-warning fw-bold">
                    STYLESTORE COLLECTION
                </p>

                <h2 class="fw-bold">
                    Your Style, Your Identity
                </h2>

                <p class="text-secondary mt-3">
                    Explore our latest clothing collection
                    and discover something made for your style.
                </p>

                <a href="/Product/Index" class="btn shop-btn p-3">
                    EXPLORE COLLECTION
                </a>

            </div>

            <div class="col-md-6 p-0">

                <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=900"
                     class="hero-img"
                     alt="Clothing Collection">

            </div>

        </div>
    </div>


    <!-- FOOTER -->
    <footer class="footer mt-5 p-5">

        <div class="container">

            <div class="row">

                <div class="col-md-4">

                    <h3 class="fw-bold">
                        StyleStore.
                    </h3>

                    <p class="text-secondary">
                        Your destination for stylish and
                        comfortable everyday clothing.
                    </p>

                </div>

                <div class="col-md-2">

                    <h6 class="fw-bold">Explore</h6>

                    <p>
                        <a href="/Customer/Index" class="text-secondary">
                            Home
                        </a>
                    </p>

                    <p>
                        <a href="/Home/About" class="text-secondary">
                            About
                        </a>
                    </p>

                    <p>
                        <a href="/Product/Index" class="text-secondary">
                            Shop
                        </a>
                    </p>

                </div>

                <div class="col-md-3">

                    <h6 class="fw-bold">Customer Care</h6>

                    <p>
                        <a href="/Home/Contact" class="text-secondary">
                            Contact
                        </a>
                    </p>

                    <p>
                        <a href="/Home/FAQ" class="text-secondary">
                            FAQs
                        </a>
                    </p>

                </div>

                <div class="col-md-3">

                    <h6 class="fw-bold">Follow Us</h6>

                    <a href="#" class="text-dark fs-4 me-3">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <a href="#" class="text-dark fs-4 me-3">
                        <i class="bi bi-instagram"></i>
                    </a>

                    <a href="#" class="text-dark fs-4">
                        <i class="bi bi-twitter-x"></i>
                    </a>

                </div>

            </div>

            <hr>

            <p class="text-center text-secondary mb-0">
                © 2026 StyleStore. All Rights Reserved.
            </p>

        </div>

    </footer>


    <!-- Bootstrap JavaScript -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
