
@model IEnumerable<StyleStore.Models.Product>

@{
    ViewData["Title"] = "Our Products";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Our Products - StyleStore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            background: #f8f8f6;
            color: #242424;
            font-family: Arial, sans-serif;
        }

        .catalog-container {
            max-width: 1250px;
            margin: auto;
            padding: 55px 20px;
        }

        .catalog-heading {
            font-size: 34px;
            font-weight: 700;
            letter-spacing: -1px;
        }

        .catalog-subtitle {
            color: #777;
            margin-top: 8px;
        }

        .home-link {
            text-decoration: none;
            color: #242424;
            border: 1px solid #ddd;
            background: white;
            padding: 10px 18px;
            border-radius: 7px;
            transition: 0.2s;
        }

        .home-link:hover {
            background: #242424;
            color: white;
        }

        .product-card {
            height: 100%;
            background: white;
            border: 1px solid #ececec;
            border-radius: 12px;
            overflow: hidden;
            transition: transform 0.25s, box-shadow 0.25s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .product-image-box {
            height: 320px;
            background: #f4f3f0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
        }

        .product-image {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .product-info {
            padding: 22px;
        }

        .category-label {
            display: inline-block;
            background: #f1eee8;
            color: #74664e;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 11px;
            border-radius: 20px;
            margin-bottom: 13px;
        }

        .product-name {
            font-size: 20px;
            font-weight: 650;
            margin-bottom: 10px;
        }

        .product-description {
            font-size: 14px;
            color: #777;
            line-height: 1.7;
            min-height: 48px;
            margin-bottom: 20px;
        }

        .product-footer {
            border-top: 1px solid #eee;
            padding-top: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .product-price {
            font-size: 21px;
            font-weight: 700;
            color: #222;
        }

        .product-number {
            color: #999;
            font-size: 12px;
        }

        @@media (max-width: 576px) {
            .catalog-container {
                padding: 30px 15px;
            }

            .catalog-heading {
                font-size: 27px;
            }

            .product-image-box {
                height: 280px;
            }
        }
    </style>
</head>

<body>

    <main class="catalog-container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">

            <div>
                <h1 class="catalog-heading">Discover Our Collection</h1>
                <p class="catalog-subtitle">
                    Explore quality clothing for every member of your family.
                </p>
            </div>

            <a href="/Customer/Index" class="home-link">
                ← Back to Home
            </a>

        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h4>No products available</h4>
                <p class="text-muted">Please check back later.</p>
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">

                @foreach (var product in Model)
                {
                    <div class="col">

                        <article class="product-card">

                            <div class="product-image-box">

                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         class="product-image"
                                         loading="lazy">
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Image unavailable
                                    </span>
                                }

                            </div>

                            <div class="product-info">

                                <span class="category-label">
                                    @product.Category.Name
                                </span>

                                <h2 class="product-name">
                                    @product.Name
                                </h2>

                                <p class="product-description">
                                    @product.Description
                                </p>

                                <div class="product-footer">

                                    <span class="product-price">
                                        Rs. @product.Price.ToString("N0")
                                    </span>

                                    <span class="product-number">
                                        Product #@product.Id
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }

    </main>

</body>
</html>
