
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StyleStore Admin Dashboard</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f6fa;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            background-color: #252525;
            min-height: 100vh;
        }

        .sidebar a {
            color: #cccccc;
            text-decoration: none;
            display: block;
            padding: 13px;
        }

        .sidebar a:hover,
        .sidebar a.active {
            background-color: #e98b55;
            color: white;
        }

        .admin-brand {
            color: white;
            font-size: 25px;
            font-weight: bold;
        }

        .dashboard-card {
            border: none;
        }

        .dashboard-icon {
            font-size: 30px;
            color: #e98b55;
        }

        .content-heading {
            font-weight: bold;
        }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <div class="col-md-2 sidebar p-3">

                <h3 class="admin-brand mb-4">
                    StyleStore.
                </h3>

                <a href="/Admin/Index" class="active">
                    <i class="bi bi-grid me-2"></i>
                    Dashboard
                </a>

                <a href="/Admin/Products">
                    <i class="bi bi-box-seam me-2"></i>
                    Products
                </a>

                <a href="/Admin/Categories">
                    <i class="bi bi-tags me-2"></i>
                    Categories
                </a>

                <a href="/Admin/Orders">
                    <i class="bi bi-cart me-2"></i>
                    Orders
                </a>

                <a href="/Admin/Customers">
                    <i class="bi bi-people me-2"></i>
                    Customers
                </a>

                <a href="/Admin/Inventory">
                    <i class="bi bi-boxes me-2"></i>
                    Inventory
                </a>

                <a href="/Admin/Settings">
                    <i class="bi bi-gear me-2"></i>
                    Settings
                </a>

                <a href="/Identity/Account/Logout" class="mt-4">
                    <i class="bi bi-box-arrow-right me-2"></i>
                    Logout
                </a>

            </div>


            <!-- MAIN CONTENT -->
            <div class="col-md-10 p-4">

                <!-- TOP NAVBAR -->
                <div class="d-flex justify-content-between align-items-center bg-white p-3 rounded shadow-sm mb-4">

                    <h4 class="mb-0 content-heading">
                        Admin Dashboard
                    </h4>

                    <div>
                        <i class="bi bi-bell fs-5 me-3"></i>
                        <i class="bi bi-person-circle fs-4"></i>
                        <span class="ms-2">Admin</span>
                    </div>

                </div>


                <!-- WELCOME SECTION -->
                <div class="mb-4">

                    <h3 class="content-heading">
                        Welcome Back, Admin!
                    </h3>

                    <p class="text-secondary">
                        Here's what's happening with your store today.
                    </p>

                </div>


                <!-- STATISTICS CARDS -->
                <div class="row g-3 mb-4">

                    <div class="col-12 col-sm-6 col-xl-3">

                        <div class="card dashboard-card shadow-sm p-3">

                            <i class="bi bi-cart dashboard-icon"></i>

                            <h6 class="text-secondary mt-3">
                                Total Orders
                            </h6>

                            <h3 class="fw-bold">125</h3>

                        </div>

                    </div>


                    <div class="col-12 col-sm-6 col-xl-3">

                        <div class="card dashboard-card shadow-sm p-3">

                            <i class="bi bi-box-seam dashboard-icon"></i>

                            <h6 class="text-secondary mt-3">
                                Total Products
                            </h6>

                            <h3 class="fw-bold">86</h3>

                        </div>

                    </div>


                    <div class="col-12 col-sm-6 col-xl-3">

                        <div class="card dashboard-card shadow-sm p-3">

                            <i class="bi bi-people dashboard-icon"></i>

                            <h6 class="text-secondary mt-3">
                                Total Customers
                            </h6>

                            <h3 class="fw-bold">240</h3>

                        </div>

                    </div>


                    <div class="col-12 col-sm-6 col-xl-3">

                        <div class="card dashboard-card shadow-sm p-3">

                            <i class="bi bi-currency-rupee dashboard-icon"></i>

                            <h6 class="text-secondary mt-3">
                                Total Revenue
                            </h6>

                            <h3 class="fw-bold">Rs. 450K</h3>

                        </div>

                    </div>

                </div>


                <!-- RECENT ORDERS -->
                <div class="card shadow-sm border-0">

                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <h5 class="fw-bold">
                                Recent Orders
                            </h5>

                            <a href="/Admin/Orders" class="text-warning">
                                View All
                            </a>

                        </div>

                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Product</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <tr>
                                        <td>#1001</td>
                                        <td>Ali</td>
                                        <td>Classic T-Shirt</td>
                                        <td>Rs. 2,499</td>
                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>#1002</td>
                                        <td>Ahmed</td>
                                        <td>Denim Jeans</td>
                                        <td>Rs. 4,499</td>
                                        <td>
                                            <span class="badge bg-success">
                                                Delivered
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>#1003</td>
                                        <td>Sara</td>
                                        <td>Women's Top</td>
                                        <td>Rs. 2,999</td>
                                        <td>
                                            <span class="badge bg-info text-dark">
                                                Processing
                                            </span>
                                        </td>
                                    </tr>

                                    <tr>
                                        <td>#1004</td>
                                        <td>Usman</td>
                                        <td>Casual Shirt</td>
                                        <td>Rs. 3,499</td>
                                        <td>
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>


                <!-- LOW STOCK PRODUCTS -->
                <div class="card shadow-sm border-0 mt-4">

                    <div class="card-body">

                        <h5 class="fw-bold mb-3">
                            Low Stock Products
                        </h5>

                        <div class="table-responsive">

                            <table class="table table-hover">

                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>Category</th>
                                        <th>Available Stock</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    <tr>
                                        <td>Classic T-Shirt</td>
                                        <td>Men</td>
                                        <td class="text-danger fw-bold">3</td>
                                    </tr>

                                    <tr>
                                        <td>Women's Casual Top</td>
                                        <td>Women</td>
                                        <td class="text-danger fw-bold">5</td>
                                    </tr>

                                    <tr>
                                        <td>Kids Summer Dress</td>
                                        <td>Kids</td>
                                        <td class="text-danger fw-bold">2</td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</body>
</html>
