@model StyleStore.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>StyleStore Admin Dashboard</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">
</head>

<body class="bg-light">

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Admin Dashboard</h2>

        <a href="/Customer/Index" class="btn btn-outline-secondary">
            Customer Homepage
        </a>

    </div>

    <h4 class="mb-2">Welcome Back, Admin!</h4>

    <p class="text-secondary mb-4">
        Here is your store overview.
    </p>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-secondary">Total Products</h6>

                    <h2 class="fw-bold">
                        @Model.TotalProducts
                    </h2>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-secondary">Total Categories</h6>

                    <h2 class="fw-bold">
                        @Model.TotalCategories
                    </h2>

                </div>
            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0">
                <div class="card-body">

                    <h6 class="text-secondary">Registered Users</h6>

                    <h2 class="fw-bold">
                        @Model.TotalUsers
                    </h2>

                </div>
            </div>

        </div>

    </div>

    <div class="card border-0 shadow-sm mt-4">

        <div class="card-body">

            <h5>Dashboard Information</h5>

            <p class="text-secondary mb-0">
                Product, category and registered-user statistics
                are retrieved dynamically from the database.
            </p>

        </div>

    </div>

</div>

</body>
</html>