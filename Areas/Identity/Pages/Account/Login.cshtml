@page
@model LoginModel

@{
    ViewData["Title"] = "WELCOME";
}

<div class="container mt-4">
    <!-- Main Row -->
    <div class="row align-items-stretch shadow-lg rounded overflow-hidden">

        <!-- LEFT SIDE: Orange Promo -->
        <div class="col-lg-6 p-0">
            <div class="login-promo h-100 d-flex flex-column justify-content-center p-5" style="background-color: #f29c23; color: white;">
                <h2 class="fw-bold mb-3">Simplify shopping with StyleStore.</h2>
                <p class="mb-4">Discover products you'll love.</p>
                <img src="~/images/login-photo.png" class="img-fluid rounded-circle border border-2  mx-auto d-block" style="max-height: 400px; object-fit: cover;" alt="Promo" />
            </div>
        </div>

        <!-- RIGHT SIDE: Login Form -->
        <div class="col-lg-6 bg-white p-5 d-flex flex-column justify-content-center">
            
            <!-- Logo Circle Centered -->
            <div class="d-flex justify-content-center mb-4">
                <div class="rounded-circle border border-2  border-orange d-flex align-items-center justify-content-center" style="width: 100px; height: 100px; overflow: hidden;">
                    <img src="~/images/logo.png" class="img-fluid" style="max-width: 70%;" alt="Logo" />
                </div>
            </div>

            <hr />

            <section>
                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        
                        <label asp-for="Input.Email ">Email</label>
                        

                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    
                    <div class="checkbox mb-3">
                        <label asp-for="Input.RememberMe" class="form-label">
                            <input class="form-check-input me-2" asp-for="Input.RememberMe" />
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>
                    
                    <div>
                        <button id="login-submit" type="submit" class="w-100 btn btn-lg"  style="background-color: #f29c23; color: white;">Log in</button>
                    </div>
                    
                    <div class="mt-3 text-center">
                        <p class="mb-1">
                            <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                        </p>
                        <p class="mb-1">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                        </p>
                        <p class="mb-1">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                        </p>
                    </div>
                </form>
            </section>

        </div> <!-- End Right Side -->
    </div> <!-- End Main Row -->
</div> <!-- End Container -->

<!-- ALWAYS KEEP THIS UNCOMMENTED -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}